# The pinned Raspberry Pi 4 UEFI firmware (pftf), the one statement of it:
# scripts/sdcard.sh and scripts/pftf.sh (bootstick.py's fetch) source it, so a
# card and a one-disk Pi stick always get the same release. Bump both lines
# together; the SHA-256 is the one GitHub reports for the release asset
# (`gh release view --repo pftf/RPi4`). Plain NAME=value lines only.
FW_VERSION=v1.53
FW_SHA256=ca9973e2a7a546b3df871cfb7382e656829114b6dfa424f40dc67cc90a217d88
