/target
# All generated build artifacts (staging tree, disk images, pcaps, logs,
# sockets, transient src dirs) now live under build/ - see the Makefile.
/build/
/parallels/
/parallels-test-*/
/scratch/
/Parallels Error Reports/
.DS_Store
# picolibc: the upstream source clone and the meson/ninja build+install trees are
# large and regenerable (scripts/build-picolibc.sh). Only the small prebuilt
# static lib + headers (third_party/picolibc-prebuilt) is committed.
/third_party/picolibc/
/third_party/pico-build/
/third_party/pico-install/
/third_party/picolibc-cross.resolved.txt
__pycache__/
# The /day-closeout skill's standup brief: a personal "where was I" note,
# rewritten from scratch every time it runs. The durable record of a day lives
# in docs/journal.md, docs/CHANGELOG.md, docs/roadmap.md and the postmortems,
# all of which go through a PR - so committing a file designed to be overwritten
# daily would add churn to a history where nothing else churns.
/docs/daily-standup.md
